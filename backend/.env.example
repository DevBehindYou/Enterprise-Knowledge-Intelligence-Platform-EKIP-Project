# ============================================================
# EKIP backend — environment template. Copy to backend/.env and fill in.
# In production (Render) set these in the dashboard, not in a file.
# ============================================================

# ---- Supabase (Auth only) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- MongoDB Atlas (M0 free tier supports Vector Search) ----
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=App
MONGODB_DB_NAME=EKIPT_Project
VECTOR_INDEX_NAME=chunk_vector_index
# Must match your embedding model's output size (1536 for gemini-embedding-001
# as configured, or OpenAI text-embedding-3-small; 768 for nomic-embed-text).
VECTOR_DIMENSIONS=1536

# ---- App session (Express JWT + refresh cookie) ----
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=ekip_rt
# Leave BLANK in production — a split Vercel/Render deploy needs a host-only
# cookie. Only set to a real shared parent domain if front+API share one.
REFRESH_COOKIE_DOMAIN=

# ---- LLM (chat generation) ----
# Configured per-tenant in Settings → AI Integration; these are the fallback.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=your-ollama-cloud-key

# ---- Embeddings (Gemini free tier) ----
EMBEDDING_PROVIDER=gemini
# Standard AI Studio key (starts with AIza...): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Ingestion queue (BullMQ / Redis; Upstash free tier) ----
REDIS_URL=rediss://default:token@your-host.upstash.io:6379
# Free-tier single-service deploy: run the ingestion worker inside the API.
# Leave unset/false if you run `npm run worker` as its own service.
RUN_INLINE_WORKER=true

# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Number of trusted reverse-proxy hops. Set to 1 on Render/most PaaS; leave
# blank only when the API is directly internet-facing.
TRUST_PROXY=
# https://<your-app>.vercel.app in production (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
DEFAULT_TENANT_ID=000000000000000000000001
