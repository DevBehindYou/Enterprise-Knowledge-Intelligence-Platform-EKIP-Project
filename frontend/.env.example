# ---- API base URL ----
# Local dev: leave as "/api" — vite.config.js proxies /api → http://localhost:4000.
# Production (Vercel): set this to the absolute backend URL, e.g.
#   VITE_API_BASE_URL=https://ekip-backend.onrender.com/api
# Set it in the Vercel project's Environment Variables (it's baked in at build time).
VITE_API_BASE_URL=/api

# ---- Supabase (client-side auth) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
